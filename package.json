{
  "name": "aerosentinel",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm --workspace @lending/web run dev",
    "dev:api": "npm --workspace @lending/api run dev",
    "build": "npm --workspace @lending/shared run build && npm --workspace @lending/api run build && npm --workspace @lending/web run build",
    "start:web": "npm --workspace @lending/web run start",
    "start:api": "npm --workspace @lending/api run start",
    "test": "npm --workspace @lending/api run build"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
