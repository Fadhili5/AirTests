NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/telegram_lending
JWT_SECRET=replace-with-32-char-secret
JWT_EXPIRES_IN=7d
BOT_INTERNAL_TOKEN=replace-with-shared-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
CORS_ORIGIN=https://miniapp.example.com
API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=https://t.me/your_support

API_PORT=4000
WEB_PORT=3000
BOT_PORT=5000

TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-secret
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
TELEGRAM_MINI_APP_URL=https://miniapp.example.com
SUPPORT_TELEGRAM_URL=https://t.me/your_support

MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=encrypted-credential
MPESA_RESULT_URL=https://api.example.com/webhooks/mpesa/b2c/result?token=replace-with-callback-token
MPESA_TIMEOUT_URL=https://api.example.com/webhooks/mpesa/b2c/timeout?token=replace-with-callback-token
MPESA_CALLBACK_URL=https://api.example.com/webhooks/mpesa/stk?token=replace-with-callback-token
MPESA_CALLBACK_TOKEN=replace-with-callback-token
MPESA_B2C_COMMAND=BusinessPayment
MPESA_B2C_REMARKS=Loan payout
MPESA_QUEUE_TIMEOUT_SECONDS=120

APP_NAME=KopaBot
LOAN_BASE_INTEREST_RATE=12
LOAN_MAX_MULTIPLIER=0.5
VERIFICATION_HOLD_AMOUNT=100
